#version 460
layout(local_size_x=8,local_size_y=8) in;
layout(push_constant) uniform Conversion { uvec4 sizes; vec4 eyeMode; vec4 forward; vec4 jitter; };
layout(set=0,binding=0,std430) readonly buffer Color {vec4 color[];};
layout(set=0,binding=1,std430) readonly buffer Guides {vec4 guide[];};
layout(set=0,binding=2,std430) readonly buffer Motion {vec4 motion[];};
layout(set=0,binding=3,std430) writeonly buffer Output {vec4 outputColor[];};
layout(set=0,binding=4,rgba16f) uniform image2D colorImage;
layout(set=0,binding=5,r32f) uniform image2D depthImage;
layout(set=0,binding=6,rg16f) uniform image2D motionImage;
layout(set=0,binding=7,r8) uniform image2D reactiveImage;
layout(set=0,binding=8,rgba16f) uniform image2D outputImage;

// Previous unjittered camera projection. Object points already include the previous transform.
vec2 previousUv(vec3 direction) {
    vec3 e1=motion[3].xyz,e2=motion[4].xyz;
    vec3 normal=normalize(cross(e1,e2));
    float denominator=dot(direction,normal);
    if(abs(denominator)<1e-8) return vec2(-2);
    float t=dot(motion[2].xyz-motion[1].xyz,normal)/denominator;
    if(t<=0) return vec2(-2);
    vec3 delta=motion[1].xyz+direction*t-motion[2].xyz;
    vec2 uv=vec2(dot(delta,e1)/dot(e1,e1),dot(delta,e2)/dot(e2,e2));
    return vec2(uv.x,1-uv.y);
}
void main() {
    uvec2 xy=gl_GlobalInvocationID.xy;
    bool compose=eyeMode.w>0;
    uvec2 size=compose?sizes.zw:sizes.xy;
    if(any(greaterThanEqual(xy,size))) return;
    ivec2 texel=ivec2(xy.x,size.y-1-xy.y);
    uint index=xy.y*size.x+xy.x;
    if(compose) { outputColor[index]=vec4(max(imageLoad(outputImage,texel).xyz,vec3(0)),0); return; }
    uint g=index*6;
    bool sky=guide[g].w<0;
    float z=dot(guide[g].xyz-eyeMode.xyz,forward.xyz);
    bool valid=sky || z>.01;
    float depth=sky || !valid?1:clamp(100000./(100000.-.01)*(1-.01/z),0,1);
    vec2 current=(vec2(xy)+.5+jitter.xy)/vec2(size);
    current.y=1-current.y;
    vec3 direction=sky?guide[g+2].xyz:guide[g+2].xyz-motion[1].xyz;
    vec2 mv=valid?previousUv(direction)-current:vec2(0);
    float reactive=sky?1-guide[g+2].w:max(guide[g+3].w,1-guide[g+2].w);
    reactive=max(reactive,1-jitter.z);
    imageStore(colorImage,texel,vec4(clamp(color[index].xyz,vec3(0),vec3(65504)),1));
    imageStore(depthImage,texel,vec4(depth));
    imageStore(motionImage,texel,vec4(mv,0,0));
    imageStore(reactiveImage,texel,vec4(valid?reactive:1));
}
