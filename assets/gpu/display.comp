#version 460
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Source { vec4 radiance[]; };
layout(std430,binding=1) buffer Destination { uint packed[]; };
layout(std430,binding=2) readonly buffer Encoding { uint srgb[]; };
layout(push_constant) uniform Settings { uint width; uint height; float exposure; };
shared uint reused[64];
double widened(float value) {
    uint bits=floatBitsToUint(value);
    if((bits&0x7f800000u)==0) {
        double magnitude=ldexp(double(bits&0x7fffffu),-149);
        return (bits&0x80000000u)==0?magnitude:-magnitude;
    }
    return double(value);
}
uint encode(float value) {
    // Widen explicitly: GPU float arithmetic may flush input subnormals to zero.
    precise float exposed=float(widened(value)*widened(exposure));
    if(isnan(exposed)) return srgb[0];
    precise float positive=max(0,exposed);
    precise float denominator=1+positive;
    precise float mapped=isinf(positive)?1:float(double(positive)/double(denominator));
    precise float scaled=mapped*65535;
    return srgb[min(65535u,uint(floor(double(scaled)+0.5)))];
}
void main() {
    uint index=gl_GlobalInvocationID.x;
    uint lane=gl_LocalInvocationID.x;
    uint count=width*height;
    reused[lane]=0;
    if(index<count) {
        vec4 value=radiance[index];
        uint target=(height-1-index/width)*width+index%width;
        packed[target]=(encode(value.r)<<16)|(encode(value.g)<<8)|encode(value.b);
        reused[lane]=value.a>0?1u:0u;
    }
    barrier();
    for(uint stride=32;stride>0;stride/=2) {
        if(lane<stride) reused[lane]+=reused[lane+stride];
        barrier();
    }
    if(lane==0 && reused[0]>0) atomicAdd(packed[count],reused[0]);
}
