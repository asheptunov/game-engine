bool compatibleSmooth(uint reference, uint candidate) {
    vec4 a=smoothGuides[reference*2u], b=smoothGuides[candidate*2u];
    if (smoothGuides[reference*2u+1u].x!=smoothGuides[candidate*2u+1u].x) return false;
    if (a.w==0 && b.w==0) return true;
    return dot(a.xyz,b.xyz)>.9 && abs(a.w-b.w)<max(.02,.03*max(a.w,b.w));
