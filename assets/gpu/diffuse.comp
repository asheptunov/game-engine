// A primary miss still needs native visibility, but atmospheric radiance varies slowly within
// a lighting pixel. Reuse only other misses and evaluate the visible sun disc at the native ray.
bool reconstructSky(vec3 direction, vec2 position, out vec3 result) {
    vec2 low=position*vec2(grid.xy)/vec2(nativeWidth,nativeHeight)-.5;
    ivec2 base=ivec2(floor(low));
    vec3 environment=mix(nadir.xyz,zenith.xyz,clamp((direction.y+1)*.5,0,1));
    if(dot(direction,discDirection.xyz)>=discDirection.w) environment=discRadiance.xyz;
    vec3 total=vec3(0); float weight=0;
    for(int y=0;y<2;y++) for(int x=0;x<2;x++) {
        ivec2 cell=base+ivec2(x,y);
        if(any(lessThan(cell,ivec2(0))) || any(greaterThanEqual(cell,ivec2(grid.xy)))) continue;
        uint g=(uint(cell.y)*grid.x+uint(cell.x))*6u;
        if(temporalGuide[g].w!=-1) continue;
        vec2 tent=max(vec2(0),1-abs(vec2(cell)-low));
        float w=tent.x*tent.y;
        total+=(temporalGuide[g+4].xyz+temporalGuide[g+3].xyz*environment)*w;
        weight+=w;
    }
    if(weight<.01) return false;
    result=total/weight;
    return true;
}

// Native pixel-center visibility selects compatible low-grid illumination. No cross-surface color
// interpolation is allowed; unsupported or uncovered surfaces trace their own complete path.
bool reconstructSurface(Hit hit, vec3 direction, vec3 point, vec2 position, out vec3 result) {
    if(instances[hit.instanceIndex*4+1].w>0) return false;
    float identity=temporalMotion[8u+uint(hit.instanceIndex)*4u+3u].x;
    if(identity==0) return false;
    vec3 normal=dot(hit.normal,direction)<0?hit.normal:-hit.normal;
    vec3 color=instances[hit.instanceIndex*4+1].w==-2?vec3(1):reflectance(hit);
    vec2 low=position*vec2(grid.xy)/vec2(nativeWidth,nativeHeight)-.5;
    ivec2 base=ivec2(floor(low));
    vec3 total=vec3(0); float weight=0;
    for(int y=-1;y<=2;y++) for(int x=-1;x<=2;x++) {
        ivec2 cell=base+ivec2(x,y);
