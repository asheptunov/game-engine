#version 460
#extension GL_EXT_ray_query : require
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0) uniform accelerationStructureEXT scene;
layout(std430,set=0,binding=1) readonly buffer Triangles { vec4 triangles[]; };
layout(std430,set=0,binding=2) readonly buffer Instances { vec4 instances[]; };
layout(std430,set=0,binding=3) readonly buffer Textures { vec4 texels[]; };
layout(std430,set=0,binding=4) readonly buffer Parameters {
    vec4 eye, origin, edge1, edge2, sunDirection, sunRadiance, nadir, zenith;
    uvec4 grid; // width, height, depth, seed low
    uvec4 sampling; // seed high, sample index, primary fog divisor, primary fog columns
    vec4 discDirection, discRadiance; // direction.w = cosine of angular radius; 2 disables disc
    vec4 airMapping; // metres/unit, ground Y, radius km, extent km; x=0 disables
    vec4 airHeights; // molecular/aerosol scale heights km, anisotropy
    vec4 airMolecular, airAerosol, airAbsorption, solarDirection, solarIrradiance;
    vec2 airColumns[18432];
    vec4 fogMeta;
    vec4 fogData[48]; // six vec4s per region, maximum eight
    vec4 fogLower, fogExtent; // lower.w: table dimension, zero disables
};
layout(std430,set=0,binding=5) buffer Accumulation { dvec4 means[]; };
layout(std430,set=0,binding=6) buffer Output { vec4 pixels[]; };
layout(std430,set=0,binding=7) buffer FogSun { vec4 fogSunValues[]; };
layout(std430,set=0,binding=8) buffer PrimaryFog { vec4 primaryFog[]; };
layout(std430,set=0,binding=9) buffer FogGuides { vec4 fogGuides[]; };
layout(set=0,binding=10) uniform sampler3D lightingTexture;
layout(rgba32f,set=0,binding=11) uniform writeonly image3D lightingImage;
layout(set=0,binding=12) readonly buffer SampleLocations { uint locations[]; };
layout(set=0,binding=13) readonly buffer SmoothLayout { uint smoothLayout[]; };
layout(set=0,binding=14) buffer SmoothGuides { vec4 smoothGuides[]; };
layout(constant_id=2) const bool useFoveation=false;
layout(constant_id=1) const bool useLightingGrid=false;
layout(constant_id=0) const int dispatchMode=0; // full, sun table, coarse fog, reconstructed
layout(constant_id=3) const bool referenceTraversal=false;
const float BIAS = 0.001;
const float PI = 3.14159265358979323846;
uint64_t randomState;
uint64_t mix64(uint64_t n) {
    n = (n ^ (n >> 30)) * 0xbf58476d1ce4e5b9UL;
    n = (n ^ (n >> 27)) * 0x94d049bb133111ebUL;
    return n ^ (n >> 31);
}
float randomValue() {
    randomState += 0x9e3779b97f4a7c15UL;
    return float(mix64(randomState) >> 40) * (1.0 / 16777216.0);
}
struct Hit { float t; int instanceIndex; int triangleIndex; int face; vec3 normal; vec3 localPoint; vec3 localNormal; };
bool nearest(vec3 o, vec3 d, int skipInstance, int skipFace, bool shadow, out Hit hit) {
    hit.t = 1e30;
    hit.instanceIndex = -1;
    hit.triangleIndex = -1;
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene, 0, 255, o, 0.0001, d, 1e30);
    // Keep candidate filtering for source-face rejection and the CPU distance cutoff.
    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
        int objectIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(query, false);
        int primitive = rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
        int triangleIndex = (int(instances[objectIndex*4].w) + primitive) * 3;
        int face = int(triangles[triangleIndex].w);
        if (objectIndex == skipInstance && face == skipFace) continue;
        float t = rayQueryGetIntersectionTEXT(query, false);
        if (t <= 0.0001) continue; // Match the CPU surface-distance cutoff.
        bool earlier = objectIndex < hit.instanceIndex || (objectIndex == hit.instanceIndex && primitive < hit.triangleIndex);
        if (t > hit.t || (t == hit.t && !earlier)) continue;
        hit.t = t;
        hit.instanceIndex = objectIndex;
        hit.triangleIndex = primitive;
        hit.face = face;
        if (shadow) return true;
        // Let hardware prune farther geometry. Keep scene-order ties among returned candidates;
        // reference mode visits every candidate, including ties a driver could prune.
        if (!referenceTraversal) rayQueryConfirmIntersectionEXT(query);
        vec3 a = triangles[triangleIndex].xyz;
        vec3 b = triangles[triangleIndex+1].xyz;
        vec3 c = triangles[triangleIndex+2].xyz;
        hit.localNormal = normalize(cross(b-a,c-a));
        mat4x3 inverseTransform = rayQueryGetIntersectionWorldToObjectEXT(query, false);
        hit.normal = normalize(transpose(mat3(inverseTransform))*hit.localNormal);
        hit.localPoint = rayQueryGetIntersectionObjectRayOriginEXT(query, false) + t*rayQueryGetIntersectionObjectRayDirectionEXT(query, false);
    }
    return hit.instanceIndex >= 0;
}
vec3 reflectance(Hit hit) {
    int base = hit.instanceIndex * 4;
    if (instances[base+1].w == -2) return instances[base].xyz;
    vec3 n = hit.localNormal, p = hit.localPoint;
    vec2 uv;
    int faceTexture;
    if (abs(n.y) >= max(abs(n.x),abs(n.z))) {
        faceTexture = n.y > 0 ? 1 : 2;
        uv = vec2(p.x+1, n.y > 0 ? p.z+1 : 1-p.z)*0.5;
    } else if (abs(n.x) >= abs(n.z)) {
        faceTexture = 3;
        uv = vec2(n.x > 0 ? 1-p.z : p.z+1,1-p.y)*0.5;
    } else {
        faceTexture = 3;
        uv = vec2(n.z > 0 ? 1-p.x : p.x+1,1-p.y)*0.5;
    }
    vec3 texture = instances[base+faceTexture].xyz;
    vec3 color = instances[base].xyz;
    if (texture.x < 0) return color;
    ivec2 size = ivec2(texture.yz);
    ivec2 xy = clamp(ivec2(floor(uv*size)),ivec2(0),size-1);
    return color*texels[int(texture.x)+xy.y*size.x+xy.x].xyz;
}
vec3 cosineDirection(vec3 n) {
    float u = randomValue(), v = randomValue();
    float r = sqrt(u), phi = 2*PI*v;
    vec3 tangent = abs(n.z) < 0.999 ? normalize(vec3(-n.y,n.x,0)) : normalize(vec3(0,-n.z,n.y));
    return tangent*(r*cos(phi)) + cross(n,tangent)*(r*sin(phi)) + n*sqrt(1-u);
}

// Same finite-width reciprocal thin-sheet BSDF as engine.LeafOptics.
vec3 leafResponse(int instanceIndex, vec3 incoming, vec3 outgoing, vec3 n, vec3 color, out float pdf) {
    vec4 tint=instances[instanceIndex*4+2];
    vec3 optics=instances[instanceIndex*4+3].xyz;
    float ci=-dot(n,incoming), co=dot(n,outgoing);
    pdf=0;
    if(ci<=0 || co==0) return vec3(0);
    if(co>0) { pdf=(1-optics.x)*co/PI; return color*pdf; }
    float alignment=dot(incoming,outgoing);
    float power=alignment>0 ? pow(alignment,optics.z) : 0;
    float diffuse=(1-optics.y)/PI, lobe=optics.y*power/(2*PI);
    pdf=optics.x*(-co*diffuse+(optics.z+1)*lobe);
    float thickness=tint.w*.5*(1/max(.02,ci)+1/max(.02,-co));
    return optics.x*(-co)*(diffuse+(optics.z+2)*lobe)*pow(tint.xyz,vec3(thickness));
}
vec3 sampleLeaf(int instanceIndex, vec3 incoming, vec3 n, vec3 color, out vec3 outgoing) {
    vec3 optics=instances[instanceIndex*4+3].xyz;
    float u=randomValue(), v=randomValue();
    bool transmit=u<optics.x;
    float local=transmit ? u/optics.x : (u-optics.x)/(1-optics.x);
    bool forward=transmit && local<optics.y;
    vec3 axis=n;
    float cosine;
    if(forward) { cosine=pow(local/optics.y,1/(optics.z+1)); axis=incoming; }
    else {
        if(transmit) { local=(local-optics.y)/(1-optics.y); axis=-n; }
        cosine=sqrt(max(0,1-local));
    }
    vec3 tangent=abs(axis.z)<.999 ? normalize(vec3(-axis.y,axis.x,0)) : normalize(vec3(0,-axis.z,axis.y));
    float sine=sqrt(max(0,1-cosine*cosine));
    outgoing=tangent*(sine*cos(2*PI*v))+cross(axis,tangent)*(sine*sin(2*PI*v))+axis*cosine;
    float pdf;
    vec3 response=leafResponse(instanceIndex,incoming,outgoing,n,color,pdf);
    return transmit!=(dot(n,outgoing)<0) || pdf==0 ? vec3(0) : response/pdf;
}

float airHeight(float h, float mu, float t) {
    float delta = h*(2*airMapping.z+h)+t*(2*(airMapping.z+h)*mu+t);
    return delta/(sqrt(airMapping.z*airMapping.z+delta)+airMapping.z);
}
float airBoundary(float h, float mu, bool ground) {
    float r = airMapping.z+h;
    float c = ground ? h*(2*airMapping.z+h) : (h-airMapping.w)*(2*airMapping.z+h+airMapping.w);
    float discriminant = r*r*mu*mu-c;
    if (ground) return mu<0 && discriminant>=0 ? max(0,-r*mu-sqrt(discriminant)) : 1e30;
    return max(0,-r*mu+sqrt(max(0,discriminant)));
}
float airAltitude(float y) { return clamp((y-airMapping.y)*airMapping.x*.001,0,airMapping.w); }
vec3 airExtinction(vec2 density) {
    return (airMolecular.xyz+airAbsorption.xyz)*density.x+airAerosol.xyz*density.y;
}
bool airOptical(float h, float mu, out vec2 result) {
    float horizon=-sqrt(h*(2*airMapping.z+h))/(airMapping.z+h);
    if (mu<horizon || (h==0 && mu<0)) return false;
    float y=sqrt(clamp(h/airMapping.w,0,1))*95;
    float x=sqrt(clamp((mu-horizon)/(1-horizon),0,1))*191;
    int ix=min(int(x),190), iy=min(int(y),94);
    float u=x-ix, v=y-iy;
    int a=iy*192+ix;
    result=mix(mix(airColumns[a],airColumns[a+1],u),mix(airColumns[a+192],airColumns[a+193],u),v);
    return true;
}
vec3 solarDiscTransmission(float y) {
    float h=airAltitude(y);
    float horizon=-sqrt(h*(2*airMapping.z+h))/(airMapping.z+h);
    vec2 optical;
    airOptical(h,max(solarDirection.y,horizon+1e-7),optical);
    return solarIrradiance.xyz*exp(-airExtinction(optical));
}
vec3 airSun(float y) {
    float h=airAltitude(y);
    float horizon=-sqrt(h*(2*airMapping.z+h))/(airMapping.z+h);
    float x=clamp((asin(solarDirection.y)-asin(horizon))/radians(.266),-1,1);
    float visible=(acos(-x)+x*sqrt(1-x*x))/PI;
    return solarDiscTransmission(y)*visible;
}
void airSegment(float y, vec3 d, float distance, bool disc, int steps, out vec3 light, out vec3 transmission) {
    float h=airAltitude(y), ground=airBoundary(h,d.y,true);
    float length=min(min(airBoundary(h,d.y,false),ground),distance*airMapping.x*.001);
    float cosine=dot(d,solarDirection.xyz), g=airHeights.z;
    float rayleigh=3*(1+cosine*cosine)/(16*PI);
    float aerosolPhase=(1-g*g)/(4*PI*pow(1+g*g-2*g*cosine,1.5));
    light=vec3(0); transmission=vec3(1);
    for (int i=0;i<steps;i++) {
        float a=length*float(i*i)/float(steps*steps), b=length*float((i+1)*(i+1))/float(steps*steps);
        float t=(a+b)*.5, step=b-a;
        float localH=max(0,airHeight(h,d.y,t));
        float solarMu=((airMapping.z+h)*solarDirection.y+t*cosine)/(airMapping.z+localH);
        vec2 density=exp(-localH/airHeights.xy), optical, secondary;
        bool lit=airOptical(localH,solarMu,optical);
        bool upperLit=airOptical(min(airMapping.w,localH+airHeights.x),solarMu,secondary);
        vec3 molecular=airMolecular.xyz*density.x, aerosol=airAerosol.xyz*density.y;
        vec3 extinction=airExtinction(density);
        vec3 source=(lit ? exp(-airExtinction(optical)) : vec3(0))*(molecular*rayleigh+aerosol*aerosolPhase);
        if (upperLit) {
            vec3 tau=airExtinction(density*airHeights.xy);
            vec3 albedo=(molecular+aerosol)/max(extinction,vec3(1e-20));
            source += (molecular+aerosol)*exp(-airExtinction(secondary))*(1-exp(-tau))*exp(-tau*.5)
                *albedo/(4*PI*(1-.5*albedo));
        }
        vec3 trans=exp(-extinction*step);
        // Stable small optical-depth integral, avoiding cancellation in near-surface segments.
        vec3 tau=extinction*step;
        vec3 integral=mix((1-trans)/max(extinction,vec3(1e-20)),step*(1-tau*.5+tau*tau/6),lessThan(tau,vec3(.001)));
        light += transmission*solarIrradiance.xyz*source*integral;
        transmission *= trans;
    }
    if (disc && ground==1e30 && cosine>=cos(radians(.266)))
        light += solarDiscTransmission(y)/(PI*pow(sin(radians(.266)),2));
}
vec3 fogLocal(int r,vec3 p) {
    int b=r*6; p-=fogData[b].xyz;
    float c=fogData[b+1].w, s=fogData[b+2].w;
    return vec3(c*p.x-s*p.z,p.y,s*p.x+c*p.z)/fogData[b+1].xyz;
}
float fogDensity(int r,vec3 p) {
    int b=r*6; vec3 q=fogLocal(r,p);
    float edge=1, m=max(max(abs(q.x),abs(q.y)),abs(q.z));
    if(m>=1) return 0;
    if(fogData[b+5].y>0) { float t=clamp((1-m)/fogData[b+5].y,0,1); edge=t*t*(3-2*t); }
    vec3 wave=sin(q*fogData[b+5].x*PI+vec3(.7,1.3,2.1));
    float noise=.5+.5*wave.x*wave.y*wave.z;
    return fogData[b].w*edge*exp(-fogData[b+4].y*(q.y+1)*.5)
        *(1-fogData[b+4].z+fogData[b+4].z*noise);
}
bool fogInterval(int r,vec3 o,vec3 d,float limit,out vec2 bounds) {
    int b=r*6; vec3 q=fogLocal(r,o);
    float c=fogData[b+1].w,s=fogData[b+2].w;
    vec3 v=vec3(c*d.x-s*d.z,d.y,s*d.x+c*d.z)/fogData[b+1].xyz;
    bounds=vec2(0,limit);
    for(int j=0;j<3;j++) {
        if(abs(v[j])<1e-12) { if(abs(q[j])>=1) return false; }
        else { float a=(-1-q[j])/v[j],z=(1-q[j])/v[j];
            bounds.x=max(bounds.x,min(a,z)); bounds.y=min(bounds.y,max(a,z)); }
    }
    return bounds.y>bounds.x;
}
vec3 fogTransmissionReference(vec3 o,vec3 d) {
    vec3 transmission=vec3(1);
    for(int r=0;r<int(fogMeta.x);r++) {
        vec2 bounds;
        if(!fogInterval(r,o,d,1e30,bounds)) continue;
        float step=(bounds.y-bounds.x)/24, column=0;
        for(int j=0;j<24;j++) column+=fogDensity(r,o+d*(bounds.x+(float(j)+.5)*step))*step;
        transmission*=exp(-column*(fogData[r*6+2].xyz+fogData[r*6+3].xyz));
    }
    return transmission;
}
// Same world-space trilinear interpolation as FogSunTable. Outside points use quadrature.
vec3 fogTransmission(vec3 o,vec3 d) {
    int n=int(fogLower.w);
    vec3 q=(o-fogLower.xyz)/fogExtent.xyz;
    if(n==0 || any(notEqual(d,solarDirection.xyz)) || any(lessThan(q,vec3(0))) || any(greaterThan(q,vec3(1))))
        return fogTransmissionReference(o,d);
    for(int r=0;r<int(fogMeta.x);r++) {
        vec3 local=abs(fogLocal(r,o)); float edge=1-fogData[r*6+5].y;
        float c=fogData[r*6+1].w, s=fogData[r*6+2].w;
        vec3 direction=abs(vec3(c*d.x-s*d.z,d.y,s*d.x+c*d.z));
        if(any(bvec3(direction.x<.3 && local.x>edge && local.x<1.1,
                     direction.y<.3 && local.y>edge && local.y<1.1,
                     direction.z<.3 && local.z>edge && local.z<1.1)))
            return fogTransmissionReference(o,d);
    }
    vec3 cell=q*float(n-1); ivec3 a=min(ivec3(cell),ivec3(n-2)); vec3 f=cell-vec3(a), value=vec3(0);
    for(int z=0;z<2;z++) for(int y=0;y<2;y++) for(int x=0;x<2;x++) {
        int index=((a.z+z)*n+a.y+y)*n+a.x+x;
        value+=fogSunValues[index].xyz*(x==0?1-f.x:f.x)*(y==0?1-f.y:f.y)*(z==0?1-f.z:f.z);
    }
    return value;
}
void buildFogSun() {
    int n=int(fogLower.w), index=int(gl_WorkGroupID.x)*64+int(gl_LocalInvocationIndex);
    if(index>=n*n*n) return;
    ivec3 node=ivec3(index%n,(index/n)%n,index/(n*n));
    vec3 p=fogLower.xyz+fogExtent.xyz*vec3(node)/float(n-1);
    fogSunValues[index]=vec4(fogTransmissionReference(p,solarDirection.xyz),0);
}
vec3 fogIntegral(vec3 k,float step) {
    vec3 tau=k*step;
    return mix((1-exp(-tau))/max(k,vec3(1e-20)),step*(1-tau*.5+tau*tau/6),lessThan(tau,vec3(.001)));
}
vec3 fogScatter(vec3 p,vec3 view,vec3 direction,vec3 irradiance) {
    if(all(equal(irradiance,vec3(0)))) return vec3(0);
    Hit obstruction;
    if(nearest(p,direction,-1,-1,true,obstruction)) return vec3(0);
    vec3 incident=irradiance*fogTransmission(p,direction), result=vec3(0);
    float cosine=dot(view,direction);
    for(int r=0;r<int(fogMeta.x);r++) {
        float g=fogData[r*6+4].x;
        float phase=(1-g*g)/(4*PI*pow(1+g*g-2*g*cosine,1.5));
        result+=fogDensity(r,p)*fogData[r*6+2].xyz*phase*incident;
    }
    return result;
}
// World-space coefficients, in inverse world units. Angular phase stays per ray;
// visibility remains an exact geometry query so thin shafts cannot disappear into grid cells.
void storeLighting(ivec3 node,int field,vec3 value) {
    int n=int(fogLower.w);
    imageStore(lightingImage,node+ivec3((field%2)*n,(field/2)*n,0),vec4(value,0));
}
vec3 readLighting(vec3 q,int field) {
    float n=fogLower.w;
    vec3 texel=q*(n-1)+.5+vec3(float(field%2)*n,float(field/2)*n,0);
    return textureLod(lightingTexture,texel/(vec3(2,3,1)*n),0).xyz;
}
void buildLightingGrid() {
    int n=int(fogLower.w),index=int(gl_WorkGroupID.x)*64+int(gl_LocalInvocationIndex);
    if(index>=n*n*n) return;
    ivec3 node=ivec3(index%n,(index/n)%n,index/(n*n));
    vec3 p=fogLower.xyz+fogExtent.xyz*vec3(node)/float(n-1);
    float h=airAltitude(p.y),scale=airMapping.x*.001;
    vec2 density=exp(-h/airHeights.xy),optical,secondary;
    bool lit=airOptical(h,solarDirection.y,optical);
    bool upperLit=airOptical(min(airMapping.w,h+airHeights.x),solarDirection.y,secondary);
    vec3 molecular=airMolecular.xyz*density.x,aerosol=airAerosol.xyz*density.y;
    vec3 extinction=airExtinction(density),multiple=vec3(0);
    vec3 incident=solarIrradiance.xyz*(lit?exp(-airExtinction(optical)):vec3(0))*scale;
    if(upperLit) {
        vec3 tau=airExtinction(density*airHeights.xy);
        vec3 albedo=(molecular+aerosol)/max(extinction,vec3(1e-20));
        multiple=(molecular+aerosol)*exp(-airExtinction(secondary))*(1-exp(-tau))*exp(-tau*.5)
            *albedo/(4*PI*(1-.5*albedo))*solarIrradiance.xyz*scale;
    }
    storeLighting(node,1,incident*molecular);
    storeLighting(node,2,incident*aerosol);
    storeLighting(node,3,multiple);
    extinction*=scale;
    vec3 fogIncident=airSun(p.y)*fogSunValues[index].xyz;
    for(int r=0;r<2;r++) {
        if(r>=int(fogMeta.x)) { storeLighting(node,4+r,vec3(0)); continue; }
        float amount=fogDensity(r,p);
        storeLighting(node,4+r,amount*fogData[r*6+2].xyz*fogIncident);
        extinction+=amount*(fogData[r*6+2].xyz+fogData[r*6+3].xyz);
    }
    storeLighting(node,0,extinction);
}
float fogPhase(float g,float cosine) {
    return (1-g*g)/(4*PI*pow(1+g*g-2*g*cosine,1.5));
}
vec4 lightingPhases(vec3 d) {
    float cosine=dot(d,solarDirection.xyz);
    return vec4(3*(1+cosine*cosine)/(16*PI),fogPhase(airHeights.z,cosine),
        fogPhase(fogData[4].x,cosine),fogPhase(fogMeta.x>1?fogData[10].x:0,cosine));
}
bool sampleLightingGrid(vec3 p,vec4 phase,out vec3 k,out vec3 source) {
    vec3 q=(p-fogLower.xyz)/fogExtent.xyz;
    if(any(lessThan(q,vec3(0))) || any(greaterThan(q,vec3(1)))) return false;
    k=readLighting(q,0);
    source=readLighting(q,1)*phase.x+readLighting(q,2)*phase.y+readLighting(q,3);
    vec3 fogSource=readLighting(q,4)*phase.z+readLighting(q,5)*phase.w;
    Hit obstruction;
    if(any(greaterThan(fogSource,vec3(0))) && !nearest(p,solarDirection.xyz,-1,-1,true,obstruction)) source+=fogSource;
    return true;
}
void airPart(vec3 p,vec3 d,float distance,bool disc,inout vec3 light,inout vec3 trans) {
    if(airMapping.x<=0) return;
    vec3 a,t; airSegment(p.y,d,distance,disc,32,a,t);
    light+=trans*a; trans*=t;
}
// Independent domain: fog samples never consume surface/aperture random numbers.
// Hash each stratum separately; captured seed, ray and sample index reproduce every visit.
uint fogHash(uint value) {
    value ^= value >> 16; value *= 0x7feb352du;
    value ^= value >> 15; value *= 0x846ca68bu;
    return value ^ (value >> 16);
}
float fogOffset(uint key, int interval, int stratum) {
    return (float(fogHash(key ^ uint(interval)*0x9e3779b9u ^ uint(stratum)*0x85ebca6bu) >> 8)+.5)/16777216.;
}
void fogSegment(vec3 o,vec3 d,float distance,bool disc,out vec3 light,out vec3 trans) {
    light=vec3(0); trans=vec3(1);
    bool gridSample=useLightingGrid && !(disc && dot(d,solarDirection.xyz)>=cos(radians(.3)));
    vec4 phases=gridSample?lightingPhases(d):vec4(0);
    // Keep the very bright solar disc's transmission deterministic, as in the grid path.
    bool jittered=fogMeta.y>0 && !(disc && airMapping.x>0 && dot(d,solarDirection.xyz)>=cos(radians(.3)));
    uint jitterKey=0;
    if(jittered) {
        jitterKey=fogHash(grid.w ^ sampling.x ^ 0x464f4721u);
        jitterKey=fogHash(jitterKey ^ floatBitsToUint(o.x) ^ floatBitsToUint(d.x));
        jitterKey=fogHash(jitterKey ^ floatBitsToUint(o.y) ^ floatBitsToUint(d.y));
        jitterKey=fogHash(jitterKey ^ floatBitsToUint(o.z) ^ floatBitsToUint(d.z));
        jitterKey=fogHash(jitterKey ^ sampling.y);
    }
    float ends[16]; int count=0;
    for(int r=0;r<int(fogMeta.x);r++) {
        vec2 bounds;
