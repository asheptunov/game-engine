        vec3 sunNormal = cosine < 0 ? -n : n;
        cosine = leaf ? .5*abs(cosine) : max(0,cosine);
        if (cosine>0 && any(greaterThan(sunRadiance.xyz,vec3(0)))) {
            Hit obstruction;
            if (!nearest(p+sunNormal*BIAS,sunDirection.xyz,hit.instanceIndex,hit.face,true,obstruction)) {
                vec3 direct=sunRadiance.xyz;
                if (airMapping.x>0) {
                    vec2 optical;
                    direct *= airOptical(airAltitude(p.y),sunDirection.y,optical) ? exp(-airExtinction(optical)) : vec3(0);
                }
                radiance += weight*(glassIor == -2 ? response : color*(cosine/PI))*direct*fogTransmission(p,sunDirection.xyz);
            }
        }
        if (airMapping.x>0) {
            float solarCosine=dot(n,solarDirection.xyz);
            vec3 solarNormal=solarCosine<0 ? -n : n;
            solarCosine=leaf ? .5*abs(solarCosine) : max(0,solarCosine);
            vec3 sunlight=airSun(p.y);
            if (solarCosine>0 && any(greaterThan(sunlight,vec3(0)))) {
                Hit obstruction;
                if (!nearest(p+solarNormal*BIAS,solarDirection.xyz,hit.instanceIndex,hit.face,true,obstruction))
                    radiance += weight*(glassIor == -2 ? leafResponse(hit.instanceIndex,d,solarDirection.xyz,n,color,responsePdf) : color*(solarCosine/PI))*sunlight*fogTransmission(p,solarDirection.xyz);
            }
        }
        if (depth == grid.z) break;
        if (glassIor == -2) {
            vec3 outgoing;
            weight *= sampleLeaf(hit.instanceIndex,d,n,color,outgoing);
            if(all(equal(weight,vec3(0)))) break;
            o=p+n*(dot(n,outgoing)<0 ? -BIAS : BIAS);
            d=outgoing;
            continue;
        }
        weight *= color;
        if (all(equal(weight,vec3(0)))) break;
        if (leaf && randomValue()<.5) n=-n;
        o = p+n*BIAS;
        d = cosineDirection(n);
    }
    if(dispatchMode==8) {
        vec4 previous=nativeFallback[pixel];
        float count=previous.w+1;
        vec3 mean=previous.xyz+(radiance-previous.xyz)/count;
        nativeFallback[pixel]=vec4(mean,count);
        nativeOutput[pixel]=vec4(mean,0); return;
    }
    if(dispatchMode==3) { pixels[pixel]=vec4(radiance,0); return; }
    dvec3 mean = sampling.y == 0 ? dvec3(radiance) : means[accumulationPixel].xyz+(dvec3(radiance)-means[accumulationPixel].xyz)/double(sampling.y+1);
    means[accumulationPixel] = dvec4(mean,0);
    if (continuousSampling) return;
    // Replicate this footprint's linear-radiance estimate. The full-size raw snapshot and
    // packed display agree; the HUD is drawn later at presentation resolution.
    if (!useFoveation) { pixels[pixel]=vec4(vec3(mean),0); return; }
    for (uint by=0;by<footprint.y;by++) for (uint bx=0;bx<footprint.x;bx++) {
        pixels[(xy.y+by)*grid.x+xy.x+bx]=vec4(vec3(mean),0);
    }
}
