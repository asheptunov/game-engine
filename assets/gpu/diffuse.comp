    float radius=length(center/vec2(grid.xy)*2-1);
    uint h=(tile.x/4u)*0x1f123bb5u ^ (tile.y/4u)*0x5f356495u;
    h^=h>>16u; h*=0x7feb352du; h^=h>>15u; h*=0x846ca68bu; h^=h>>16u;
