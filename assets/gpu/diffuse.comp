void resolveSmooth(uvec2 xy) {
    if (any(greaterThanEqual(xy,grid.xy))) return;
    uvec2 size=uvec2(smoothLayout[0],smoothLayout[1]);
    vec2 coordinate=vec2(smoothPosition(smoothLayout[2],xy.x),smoothPosition(smoothLayout[3],xy.y));
    uvec2 lower=uvec2(coordinate);
    uvec2 closest=uvec2(round(coordinate));
    uint reference=closest.y*size.x+closest.x;
    vec2 extent=vec2(smoothExtent(4u,closest.x,size.x),smoothExtent(4u+size.x,closest.y,size.y));
