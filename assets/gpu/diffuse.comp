layout(constant_id=4) const bool temporalGuides = false;
layout(set=0,binding=15,std430) buffer TemporalGuides { vec4 temporalGuide[]; };
layout(set=0,binding=16,std430) readonly buffer TemporalMotion { vec4 temporalMotion[]; };

layout(constant_id=5) const bool reconstructLighting = false;
layout(push_constant) uniform NativeView { uint nativeWidth, nativeHeight, reserved0, reserved1; };
layout(set=0,binding=17,std430) writeonly buffer NativeOutput { vec4 nativeOutput[]; };
layout(set=0,binding=18,std430) readonly buffer FilteredLighting { vec4 filteredLighting[]; };
layout(set=0,binding=19,std430) buffer LightingAlbedo { vec4 lightingAlbedo[]; };
layout(set=0,binding=20,std430) buffer NativeFallback { vec4 nativeFallback[]; };
