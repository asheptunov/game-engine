float smoothPosition(uint offset, uint index) {
    return uintBitsToFloat(smoothLayout[offset+index]);
}
float smoothExtent(uint offset, uint index, uint count) {
    // The outermost sample is the center of the edge pixel; keep its jitter in bounds.
    if (index==0u || index+1u==count) return 1.;
