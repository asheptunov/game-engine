#version 460
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=8,local_size_y=8) in;
layout(std430,binding=0) readonly buffer Source { vec4 radiance[]; };
layout(std430,binding=1) buffer Destination { uint packed[]; };
layout(std430,binding=2) readonly buffer Encoding { uint srgb[]; };
layout(std430,binding=3) readonly buffer Overlay { uint overlay[]; };
layout(push_constant) uniform Settings {
    uint width; uint height; float exposure; uint targetWidth; uint targetHeight; uint unused;
};
double widened(float value) {
    uint bits=floatBitsToUint(value);
    if((bits&0x7f800000u)==0) {
        double magnitude=ldexp(double(bits&0x7fffffu),-149);
        return (bits&0x80000000u)==0?magnitude:-magnitude;
    }
    return double(value);
}
uint encode(float value) {
    // Widen explicitly: GPU float arithmetic may flush input subnormals to zero.
    precise float exposed=float(widened(value)*widened(exposure));
    if(isnan(exposed)) return srgb[0];
    precise float positive=max(0,exposed);
    precise float denominator=1+positive;
    precise float mapped=isinf(positive)?1:float(double(positive)/double(denominator));
    precise float scaled=mapped*65535;
    return srgb[min(65535u,uint(floor(double(scaled)+0.5)))];
}
void writePixel(uint x,uint y,vec3 color) {
    uint index=y*targetWidth+x;
    // Overlay patches contain straight-alpha sRGB, matching the Java UI's display-space blend.
    ivec2 ui=ivec2(vec2(x,y)*vec2(overlay[1],overlay[2])/vec2(targetWidth,targetHeight));
    for(uint i=0;i<overlay[0];i++) {
        uint r=4+i*5;
        ivec2 p=ui-ivec2(overlay[r],overlay[r+1]);
        if(p.x>=0 && p.y>=0 && p.x<int(overlay[r+2]) && p.y<int(overlay[r+3])) {
            uint argb=overlay[overlay[r+4]+uint(p.y)*overlay[r+2]+uint(p.x)];
            vec3 ink=vec3((argb>>16)&255u,(argb>>8)&255u,argb&255u);
            color=mix(color,ink,float(argb>>24)/255.0);
        }
    }
    uvec3 bytes=uvec3(clamp(floor(color+.5),0,255));
    packed[index]=0xff000000u|(bytes.r<<16)|(bytes.g<<8)|bytes.b;
}
void main() {
    uint x=gl_GlobalInvocationID.x,y=gl_GlobalInvocationID.y;
    if(unused>0) {
        if(x>=width || y>=height) return;
        vec3 value=radiance[(height-1-y)*width+x].rgb;
        vec3 color=vec3(encode(value.r),encode(value.g),encode(value.b));
        for(uint dy=0;dy<unused;dy++) for(uint dx=0;dx<unused;dx++) writePixel(x*unused+dx,y*unused+dy,color);
        return;
    }
    if(x>=targetWidth || y>=targetHeight) return;
    uint index=y*targetWidth+x;
    float scale=min(float(targetWidth)/float(width),float(targetHeight)/float(height));
    vec2 extent=vec2(width,height)*scale;
    vec2 offset=(vec2(targetWidth,targetHeight)-extent)*.5;
    vec2 lo=(vec2(x,y)-offset)/scale;
    vec2 hi=(vec2(x+1,y+1)-offset)/scale;
    vec3 color=vec3(0);
    if(lo.x>=0 && lo.y>=0 && hi.x<=float(width)+.0001 && hi.y<=float(height)+.0001) {
        vec3 sum=vec3(0); float weight=0;
        for(int sy=max(0,int(floor(lo.y)));sy<min(int(height),int(ceil(hi.y)));sy++) {
            for(int sx=max(0,int(floor(lo.x)));sx<min(int(width),int(ceil(hi.x)));sx++) {
                float w=max(0,min(hi.x,float(sx+1))-max(lo.x,float(sx)))
                       *max(0,min(hi.y,float(sy+1))-max(lo.y,float(sy)));
                sum+=radiance[(int(height)-1-sy)*int(width)+sx].rgb*w; weight+=w;
            }
        }
        vec3 value=weight>0?sum/weight:vec3(0);
        // Preserve exact source floats for equal grids and integer enlargement, including subnormals.
        if(int(floor(lo.x))==int(ceil(hi.x))-1 && int(floor(lo.y))==int(ceil(hi.y))-1) {
            value=radiance[(int(height)-1-int(floor(lo.y)))*int(width)+int(floor(lo.x))].rgb;
        }
        color=vec3(encode(value.r),encode(value.g),encode(value.b));
    }
    writePixel(x,y,color);
}
